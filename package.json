{
  "name": "routemaker",
  "private": true,
  "type": "module",
  "workspaces": [
    "app",
    "worker"
  ],
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.16.0"
  },
  "scripts": {
    "dev": "npm run build && npm run dev -w worker",
    "build": "npm run build -w app",
    "check": "prettier --check . && npm run check -w app && npm run check -w worker",
    "test": "npm test -w app && npm test -w worker",
    "format": "prettier --write .",
    "deploy": "npm run build && npm run deploy -w worker"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1"
    },
    "@cloudflare/vitest-plugin": {
      "zod": "^4.6.6"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false,
    "protobufjs": false,
    "workerd": true
  }
}
