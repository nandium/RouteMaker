{
  "name": "routemaker-app",
  "version": "1.0.0",
  "description": "RouteMaker's shared Lynx application",
  "type": "module",
  "dependencies": {
    "@lynx-js/react": "0.122.1",
    "mapbox-gl": "^3.27.0",
    "onnxruntime-web": "^1.27.0"
  },
  "devDependencies": {
    "@lynx-js/lynx-core": "0.1.4",
    "@lynx-js/qrcode-rsbuild-plugin": "0.5.0",
    "@lynx-js/react-rsbuild-plugin": "0.17.2",
    "@lynx-js/rspeedy": "0.15.2",
    "@lynx-js/types": "4.0.0",
    "@lynx-js/web-core": "0.22.1",
    "@rsbuild/core": "2.0.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/react": "^18.3.20",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true,
  "scripts": {
    "brand:assets": "node --experimental-strip-types scripts/generate-brand-assets.mjs",
    "brand:check": "node --experimental-strip-types scripts/check-brand-assets.mjs",
    "contract:check": "node scripts/check-client-contract.mjs",
    "check": "npm run brand:check && npm run contract:check && npm run format:check && tsc --noEmit && vitest run && npm run build:web",
    "format:check": "prettier --check src web scripts app.config.ts theme.css package.json",
    "build": "rspeedy build --config app.config.ts",
    "build:web": "npm run build && rsbuild build --config web/rsbuild.config.ts",
    "test": "vitest run --passWithNoTests",
    "dev:web": "rsbuild dev --config web/rsbuild.config.ts"
  }
}
