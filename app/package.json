{
  "name": "routemaker-app",
  "version": "1.0.0",
  "description": "RouteMaker's shared Lynx application",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rspeedy build --config app.config.ts && rsbuild build --config web/rsbuild.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run brand:check && npm run contract:check && npm run typecheck && npm test && npm run build",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "brand:check": "node scripts/check-brand-assets.mjs",
    "contract:check": "node scripts/check-client-contract.mjs"
  },
  "dependencies": {
    "@lynx-js/react": "0.128.0",
    "maplibre-gl": "6.15.0",
    "onnxruntime-web": "^1.30.0"
  },
  "devDependencies": {
    "@lynx-js/lynx-core": "0.1.4",
    "@lynx-js/react-rsbuild-plugin": "0.21.0",
    "@lynx-js/rspeedy": "0.18.2",
    "@lynx-js/types": "4.3.0",
    "@lynx-js/web-core": "0.26.4",
    "@rsbuild/core": "2.2.9",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/react": "^19.3.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31"
  }
}
