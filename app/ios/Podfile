IOS_DEPLOYMENT_TARGET = '15.6'

platform :ios, IOS_DEPLOYMENT_TARGET

source 'https://cdn.cocoapods.org/'

use_modular_headers!

install! 'cocoapods',
  :generate_multiple_pod_projects => true,
  :deterministic_uuids => true

# Run `npm run build` from app/ before xcodebuild; the app target copies
# app/dist/main.lynx.bundle directly and does not run a Node build phase.
LYNX_VERSION = '4.0.0'

use_frameworks!
target 'RouteMaker' do
  pod 'Lynx', LYNX_VERSION, :subspecs => [
    'Framework'
  ]

  pod 'LynxService', LYNX_VERSION, :subspecs => [
    'Image',
    'Log',
    'Http'
  ]

  # Input includes the official <input> implementation and its shadow node;
  # SVG provides the <svg> renderer. Register both on the app's LynxConfig.
  pod 'XElement', LYNX_VERSION, :subspecs => ['Input', 'SVG']
end

# Lynx 4.0's core target supplies -Werror flags that Xcode 26 cannot compile.
# Keep the documented workaround scoped to that upstream target.
post_install do |installer|
  installer.generated_projects.each do |project|
    project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = IOS_DEPLOYMENT_TARGET
        next unless target.name == 'Lynx'

        config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
        disable = ['-Wno-error', '-Wno-c99-designator',
                   '-Wno-deprecated-declarations', '-Wno-deprecated-implementations']
        ['OTHER_CPLUSPLUSFLAGS', 'OTHER_CFLAGS'].each do |key|
          flags = config.build_settings[key] || ['$(inherited)']
          flags = [flags] unless flags.is_a?(Array)
          config.build_settings[key] = flags + disable
        end
      end
    end
  end
end
